rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Accept UTC strings emitted by the Unity save format, including legacy Z dates.
    // This checks format, not calendar validity or proof of physical activity.
    function isUtcString(value) {
      return value is string && value.size() <= 40
        && value.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'
          + 'T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]'
          + '([.][0-9]{1,7})?(Z|[+]00:00)');
    }

    // Match the finite, nonnegative C# float range used in saved measurements.
    function isMeasurement(value) {
      return value is number && value >= 0 && value <= 340282346638528859811704183484516925440.0;
    }

    function validSummary(walkId) {
      let data = request.resource.data;
      let fields = ['schemaVersion', 'id', 'startedAtUtc', 'endedAtUtc',
                    'steps', 'distanceMeters', 'durationSeconds', 'uploadedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields.concat(['stepAccountingVersion']))
        && (!('stepAccountingVersion' in data) || (data.stepAccountingVersion is int && data.stepAccountingVersion == 1))
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.id is string && data.id == walkId
        && walkId.matches('[A-Za-z0-9_-]{1,128}')
        && isUtcString(data.startedAtUtc) && isUtcString(data.endedAtUtc)
        && data.steps is int && data.steps >= 0 && data.steps <= 2147483647
        && isMeasurement(data.distanceMeters)
        && isMeasurement(data.durationSeconds)
        && data.uploadedAt is timestamp && data.uploadedAt == request.time;
    }

    match /users/{userId}/walks/{walkId} {
      // Only the allowlisted summary above is stored here; GPS routes stay local.
      // Sharing is opt-in and revocable, including for existing followers.
      allow read: if isOwner(userId) || (request.auth != null
        && exists(/databases/$(database)/documents/social/$(request.auth.uid)/following/$(userId))
        && get(/databases/$(database)/documents/socialProfiles/$(userId)).data.shareActivity == true);
      allow create: if isOwner(userId) && validSummary(walkId);
      // Completed summaries are immutable. A retry may refresh the server timestamp.
      allow update: if isOwner(userId) && validSummary(walkId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadedAt']);
      allow delete: if false;
    }

    // Routes sync automatically from the recording phone while sharing is ON.
    // A known walk route is readable only by its owner or followers
    // while summary sharing is enabled. Deleting the document revokes sharing.
    match /users/{userId}/sharedRoutes/{walkId} {
      allow get: if isOwner(userId) || (request.auth != null
        && exists(/databases/$(database)/documents/social/$(request.auth.uid)/following/$(userId))
        && get(/databases/$(database)/documents/socialProfiles/$(userId)).data.shareActivity == true);
      allow list: if false;
      allow create, update: if isOwner(userId)
        && get(/databases/$(database)/documents/socialProfiles/$(userId)).data.shareActivity == true
        && exists(/databases/$(database)/documents/users/$(userId)/walks/$(walkId))
        && request.resource.data.keys().hasAll(['schemaVersion', 'walkId', 'routeJson', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['schemaVersion', 'walkId', 'routeJson', 'updatedAt'])
        && request.resource.data.schemaVersion == 1 && request.resource.data.walkId == walkId
        && request.resource.data.routeJson is string
        && request.resource.data.routeJson.size() > 0 && request.resource.data.routeJson.size() <= 200000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    function validWallet(data) {
      let fields = ['schemaVersion', 'balance', 'totalEarned', 'totalSpent', 'lastWalkId', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields.concat(['milestoneRollsClaimed']))
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.balance is int && data.balance >= 0
        && data.totalEarned is int && data.totalEarned >= 0 && data.totalEarned <= 9007199254740991
        && data.totalSpent is int && data.totalSpent >= 0 && data.totalSpent <= data.totalEarned
        && data.balance == data.totalEarned - data.totalSpent
        && milestoneCount(data) is int && milestoneCount(data) >= 0
        && milestoneCount(data) <= int(data.totalEarned / 1000)
        && data.lastWalkId is string && data.updatedAt == request.time;
    }

    function milestoneCount(data) {
      return 'milestoneRollsClaimed' in data ? data.milestoneRollsClaimed : 0;
    }

    function claimsMilestone(userId, data, old) {
      let receipt = /databases/$(database)/documents/users/$(userId)/milestoneReceipts/$(data.lastWalkId);
      return data.lastWalkId.matches('[A-Za-z0-9_-]{1,128}')
        && data.totalEarned == old.totalEarned && data.totalSpent == old.totalSpent
        && milestoneCount(data) == milestoneCount(old) + 1
        && !exists(receipt) && getAfter(receipt).data.claimedAt == request.time
        && getAfter(receipt).data.milestone == milestoneCount(data);
    }

    function awardsSavedWalk(userId, data, oldEarned, oldSpent) {
      let walk = get(/databases/$(database)/documents/users/$(userId)/walks/$(data.lastWalkId)).data;
      let receipt = /databases/$(database)/documents/users/$(userId)/pointReceipts/$(data.lastWalkId);
      return data.lastWalkId.matches('[A-Za-z0-9_-]{1,128}')
        && !('stepAccountingVersion' in walk)
        && walk.schemaVersion == 1 && walk.id == data.lastWalkId
        && walk.steps is int && walk.steps >= 0 && walk.steps <= 2147483647
        && !exists(receipt) && getAfter(receipt).data.awardedAt == request.time
        && getAfter(receipt).data.points == int(walk.steps / 10)
        && data.totalEarned == oldEarned + int(walk.steps / 10)
        && data.totalSpent == oldSpent;
    }

    // Continuous activity is separate from saved territory routes. Cursors only
    // advance; all four documents must change in the same atomic transaction.
    function activityDelta(userId) {
      let path = /databases/$(database)/documents/users/$(userId)/activity/main;
      return getAfter(path).data.totalSteps - (exists(path) ? get(path).data.totalSteps : 0);
    }
    function awardsActivity(userId, data, oldEarned, oldSpent) {
      let path = /databases/$(database)/documents/users/$(userId)/activity/main;
      let before = exists(path) ? get(path).data.totalSteps : 0;
      let after = getAfter(path).data;
      return data.lastWalkId == 'activity' && after.updatedAt == request.time
        && after.totalSteps > before
        && data.totalEarned == oldEarned + int(after.totalSteps / 10) - int(before / 10)
        && data.totalSpent == oldSpent;
    }
    match /users/{userId}/stepStreams/{streamId} {
      function validStream() {
        let data = request.resource.data;
        let aggregate = getAfter(/databases/$(database)/documents/users/$(userId)/activity/main).data;
        return streamId.matches('[a-f0-9]{32}')
          && data.keys().hasAll(['totalSteps', 'updatedAt'])
          && data.keys().hasOnly(['totalSteps', 'updatedAt'])
          && data.totalSteps is int && data.totalSteps > 0 && data.totalSteps <= 9007199254740991
          && data.updatedAt == request.time
          && aggregate.lastStreamId == streamId && aggregate.updatedAt == request.time
          && activityDelta(userId) > 0;
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validStream();
      allow update: if isOwner(userId) && validStream() && request.resource.data.totalSteps > resource.data.totalSteps;
      allow delete: if false;
    }
    match /users/{userId}/activity/main {
      function validActivity() {
        let data = request.resource.data;
        let stream = /databases/$(database)/documents/users/$(userId)/stepStreams/$(data.lastStreamId);
        let delta = getAfter(stream).data.totalSteps - (exists(stream) ? get(stream).data.totalSteps : 0);
        let wallet = getAfter(/databases/$(database)/documents/users/$(userId)/wallet/main).data;
        let player = getAfter(/databases/$(database)/documents/leaderboards/allTime/players/$(userId)).data;
        return data.keys().hasAll(['totalSteps', 'lastStreamId', 'updatedAt'])
          && data.keys().hasOnly(['totalSteps', 'lastStreamId', 'updatedAt'])
          && data.totalSteps is int && data.totalSteps > 0 && data.totalSteps <= 9007199254740991
          && data.lastStreamId.matches('[a-f0-9]{32}') && data.updatedAt == request.time
          && getAfter(stream).data.updatedAt == request.time
          && delta > 0 && activityDelta(userId) == delta
          && wallet.updatedAt == request.time && wallet.lastWalkId == 'activity'
          && player.updatedAt == request.time && player.lastWalkId == 'activity';
      }
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validActivity();
      allow delete: if false;
    }

    // Preserve the existing live client's gacha debit flow. Debits cannot mint
    // points, change total earned, or spend more than the available balance.
    function spendsPoints(data, oldEarned, oldSpent) {
      return data.totalEarned == oldEarned && data.totalSpent > oldSpent
        && data.totalSpent <= data.totalEarned;
    }

    match /users/{userId}/wallet/main {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validWallet(request.resource.data)
        && milestoneCount(request.resource.data) == 0
        && ((request.resource.data.balance == 0 && request.resource.data.totalEarned == 0
            && request.resource.data.totalSpent == 0 && request.resource.data.lastWalkId == '')
          || awardsActivity(userId, request.resource.data, 0, 0)
          || awardsSavedWalk(userId, request.resource.data, 0, 0));
      allow update: if isOwner(userId) && validWallet(request.resource.data)
        && (claimsMilestone(userId, request.resource.data, resource.data)
          || (milestoneCount(request.resource.data) == milestoneCount(resource.data)
          && (awardsActivity(userId, request.resource.data, resource.data.totalEarned, resource.data.totalSpent)
          || awardsSavedWalk(userId, request.resource.data, resource.data.totalEarned, resource.data.totalSpent)
          || spendsPoints(request.resource.data, resource.data.totalEarned, resource.data.totalSpent))));
      allow delete: if false;
    }

    match /users/{userId}/pointReceipts/{walkId} {
      function pairedWalletUpdate() {
        let wallet = /databases/$(database)/documents/users/$(userId)/wallet/main;
        let oldEarned = exists(wallet) ? get(wallet).data.totalEarned : 0;
        let after = getAfter(wallet).data;
        return after.lastWalkId == walkId && after.updatedAt == request.time
          && after.totalEarned == oldEarned + request.resource.data.points;
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['points', 'awardedAt'])
        && request.resource.data.keys().hasOnly(['points', 'awardedAt'])
        && request.resource.data.points is int && request.resource.data.points >= 0
        && request.resource.data.points <= 214748364
        && request.resource.data.awardedAt == request.time && pairedWalletUpdate();
      allow update, delete: if false;
    }

    // These owner-scoped paths already exist in production for gacha/inventory.
    match /users/{userId}/milestoneReceipts/{receiptId} {
      function pairedClaim() {
        let wallet = /databases/$(database)/documents/users/$(userId)/wallet/main;
        let old = get(wallet).data;
        let after = getAfter(wallet).data;
        return after.updatedAt == request.time && after.lastWalkId == receiptId
          && after.totalEarned == old.totalEarned && after.totalSpent == old.totalSpent
          && milestoneCount(after) == milestoneCount(old) + 1
          && request.resource.data.milestone == milestoneCount(after);
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['milestone', 'claimedAt'])
        && request.resource.data.keys().hasOnly(['milestone', 'claimedAt'])
        && request.resource.data.milestone is int && request.resource.data.milestone > 0
        && request.resource.data.claimedAt == request.time && pairedClaim();
      allow update, delete: if false;
    }

    match /users/{userId}/spendReceipts/{receiptId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/inventory/{document=**} {
      allow read, write: if isOwner(userId);
    }

    function validName(name) {
      return name is string && name.matches('[A-Za-z0-9][A-Za-z0-9 _-]{2,23}');
    }

    function validPlayer(data) {
      let fields = ['schemaVersion', 'displayName', 'totalSteps', 'totalDistanceMeters',
                    'completedWalkCount', 'lastWalkId', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields.concat(['pointsBalance', 'equippedCollarColor', 'equippedItemId']))
        && (!('pointsBalance' in data) || (data.pointsBalance is int && data.pointsBalance >= 0 && data.pointsBalance <= 9007199254740991))
        && data.schemaVersion == 1 && validName(data.displayName)
        && data.totalSteps is int && data.totalSteps >= 0 && data.totalSteps <= 9007199254740991
        && isMeasurement(data.totalDistanceMeters)
        && data.completedWalkCount is int && data.completedWalkCount >= 0
        && data.completedWalkCount <= 9007199254740991
        && data.lastWalkId is string && data.lastWalkId.matches('[A-Za-z0-9_-]{1,128}')
        && data.updatedAt == request.time;
    }

    function profileMatches(userId, name) {
      let profile = /databases/$(database)/documents/leaderboardProfiles/$(userId);
      return !existsAfter(profile) || getAfter(profile).data.displayName == name;
    }

    // Spark-compatible aggregation: the only permitted score increase is exactly
    // one saved walk, with its new receipt committed in the same atomic operation.
    function countsSavedWalk(userId, data, oldSteps, oldDistance, oldCount) {
      let walk = get(/databases/$(database)/documents/users/$(userId)/walks/$(data.lastWalkId)).data;
      let receipt = /databases/$(database)/documents/leaderboardReceipts/$(userId)/walks/$(data.lastWalkId);
      return walk.schemaVersion == 1 && walk.id == data.lastWalkId
        && walk.steps is int && walk.steps >= 0 && walk.steps <= 2147483647
        && isMeasurement(walk.distanceMeters)
        && (walk.steps > 0 || walk.distanceMeters > 0)
        && !exists(receipt) && getAfter(receipt).data.countedAt == request.time
        && data.totalSteps == oldSteps + (('stepAccountingVersion' in walk) ? 0 : walk.steps)
        && data.totalDistanceMeters == oldDistance + walk.distanceMeters
        && data.completedWalkCount == oldCount + 1;
    }

    function countsActivity(userId, data, oldSteps, oldDistance, oldCount) {
      let activity = getAfter(/databases/$(database)/documents/users/$(userId)/activity/main).data;
      return data.lastWalkId == 'activity' && activity.updatedAt == request.time
        && activityDelta(userId) > 0 && data.totalSteps == oldSteps + activityDelta(userId)
        && data.totalDistanceMeters == oldDistance && data.completedWalkCount == oldCount;
    }
    function matchesWallet(userId, data) {
      let wallet = /databases/$(database)/documents/users/$(userId)/wallet/main;
      return !('pointsBalance' in data) || data.pointsBalance == (existsAfter(wallet) ? getAfter(wallet).data.balance : 0);
    }

    match /leaderboards/allTime/players/{userId} {
      allow read: if request.auth != null;
      allow create: if isOwner(userId) && validPlayer(request.resource.data)
        && matchesWallet(userId, request.resource.data)
        && profileMatches(userId, request.resource.data.displayName)
        && (countsActivity(userId, request.resource.data, 0, 0, 0)
          || countsSavedWalk(userId, request.resource.data, 0, 0, 0));
      allow update: if isOwner(userId) && validPlayer(request.resource.data)
        && matchesWallet(userId, request.resource.data)
        && profileMatches(userId, request.resource.data.displayName)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'pointsBalance', 'equippedCollarColor', 'equippedItemId', 'updatedAt'])
          || countsActivity(userId, request.resource.data, resource.data.totalSteps,
              resource.data.totalDistanceMeters, resource.data.completedWalkCount)
          || countsSavedWalk(userId, request.resource.data, resource.data.totalSteps,
              resource.data.totalDistanceMeters, resource.data.completedWalkCount));
      allow delete: if false;
    }

    match /leaderboardReceipts/{userId}/walks/{walkId} {
      function pairedScoreUpdate() {
        let player = /databases/$(database)/documents/leaderboards/allTime/players/$(userId);
        let oldCount = exists(player) ? get(player).data.completedWalkCount : 0;
        return getAfter(player).data.lastWalkId == walkId
          && getAfter(player).data.completedWalkCount == oldCount + 1
          && getAfter(player).data.updatedAt == request.time;
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['countedAt'])
        && request.resource.data.keys().hasOnly(['countedAt'])
        && request.resource.data.countedAt == request.time
        && pairedScoreUpdate();
      allow update, delete: if false;
    }

    // An owner may choose a public nickname, but cannot submit scores here.
    match /leaderboardProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt', 'equippedCollarColor', 'equippedItemId'])
        && (!('displayName' in request.resource.data) || validName(request.resource.data.displayName))
        && request.resource.data.updatedAt == request.time
        && (!exists(/databases/$(database)/documents/leaderboards/allTime/players/$(userId))
          || getAfter(/databases/$(database)/documents/leaderboards/allTime/players/$(userId)).data.displayName
            == request.resource.data.displayName);
      allow delete: if false;
    }

    // Share a code explicitly; the directory cannot be browsed or searched.
    // Immutable, paired reservations prevent collisions, code theft and multiple
    // codes per account. A player's old UID remains a valid legacy lookup.
    match /friendCodeOwners/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && request.resource.data.code.matches('[A-HJ-NP-Z2-9]{8}')
        && !exists(/databases/$(database)/documents/friendCodeLookup/$(request.resource.data.code))
        && getAfter(/databases/$(database)/documents/friendCodeLookup/$(request.resource.data.code)).data.playerId == userId;
      allow update, delete: if false;
    }
    match /friendCodeLookup/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && code.matches('[A-HJ-NP-Z2-9]{8}')
        && request.resource.data.keys().hasOnly(['playerId'])
        && request.resource.data.playerId == request.auth.uid
        && !exists(/databases/$(database)/documents/friendCodeOwners/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/friendCodeOwners/$(request.auth.uid)).data.code == code;
      allow update, delete: if false;
    }

    match /friendCodes/{userId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['displayName', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'updatedAt'])
        && validName(request.resource.data.displayName)
        && (!('photoUrl' in request.resource.data) || (request.resource.data.photoUrl is string
          && request.resource.data.photoUrl.size() <= 32768
          && (request.resource.data.photoUrl == ''
            || (request.resource.data.photoUrl.size() <= 2048
              && request.resource.data.photoUrl.matches('https://[A-Za-z0-9-]+[.]googleusercontent[.]com/.*'))
            || request.resource.data.photoUrl.matches('data:image/jpeg;base64,/9j/[A-Za-z0-9+/]*={0,2}'))))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /socialProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['shareActivity', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['shareActivity', 'updatedAt'])
        && request.resource.data.shareActivity is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    function socialTargetExists(userId) {
      return exists(/databases/$(database)/documents/friendCodes/$(userId))
        || exists(/databases/$(database)/documents/leaderboards/allTime/players/$(userId));
    }
    function validFollow() {
      return request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }
    // A one-way follow has mirrored indexes. Only the follower can create or
    // remove it; following back is a separate operation by the other account.
    match /social/{userId}/following/{otherId} {
      allow read: if request.auth != null;
      allow create: if isOwner(userId) && userId != otherId
        && socialTargetExists(otherId) && validFollow()
        && getAfter(/databases/$(database)/documents/social/$(otherId)/followers/$(userId)).data == request.resource.data;
      allow update: if false;
      allow delete: if isOwner(userId)
        && !existsAfter(/databases/$(database)/documents/social/$(otherId)/followers/$(userId));
    }
    match /social/{userId}/followers/{otherId} {
      allow read: if request.auth != null;
      allow create: if isOwner(otherId) && userId != otherId
        && socialTargetExists(userId) && validFollow()
        && getAfter(/databases/$(database)/documents/social/$(otherId)/following/$(userId)).data == request.resource.data;
      allow update: if false;
      allow delete: if isOwner(otherId)
        && !existsAfter(/databases/$(database)/documents/social/$(otherId)/following/$(userId));
    }

    // Each relationship has two identical records, committed atomically. Only
    // the recipient can accept; either participant can decline/cancel/remove.
    match /friends/{userId}/links/{otherId} {
      function participant() { return isOwner(userId) || isOwner(otherId); }
      function mirror() {
        return /databases/$(database)/documents/friends/$(otherId)/links/$(userId);
      }
      function validLink() {
        let data = request.resource.data;
        return userId != otherId
          && data.keys().hasAll(['requestedBy', 'status', 'updatedAt'])
          && data.keys().hasOnly(['requestedBy', 'status', 'updatedAt'])
          && data.updatedAt == request.time
          && getAfter(mirror()).data == data;
      }
      allow get: if participant();
      allow list: if isOwner(userId);
      allow create: if participant() && validLink()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid
        && exists(/databases/$(database)/documents/friendCodes/$(userId))
        && exists(/databases/$(database)/documents/friendCodes/$(otherId))
        && !exists(mirror());
      allow update: if participant() && validLink()
        && resource.data.status == 'pending'
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.status == 'accepted'
        && request.resource.data.requestedBy == resource.data.requestedBy;
      allow delete: if participant() && !existsAfter(mirror());
    }

    // All paths without an explicit permission above remain private.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
